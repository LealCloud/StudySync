# ==========================================
# Runtime
# ==========================================

# Modo del cliente de backend. Valores posibles:
#   - `local` (default): monolito con Prisma + PostgreSQL. Requiere DATABASE_URL.
#   - `mock`: implementación en memoria. No requiere base de datos.
BACKEND_MODE=local

# Cadena de conexión a PostgreSQL. Requerida si BACKEND_MODE=local.
# Ejemplo: postgresql://studysync:studysync@localhost:5432/studysync
DATABASE_URL=postgresql://studysync:studysync@localhost:5432/studysync

# Secreto utilizado por Auth.js / NextAuth para firmar el JWT de sesión.
# Cada desarrollador debe generar su propio valor.
# Generar con: openssl rand -base64 32
AUTH_SECRET=

# URL pública de la aplicación. Se usa para construir enlaces en correos
# transaccionales (p. ej. recuperación de contraseña).
# En producción: la URL real del despliegue ej:(https://studysync.co).
# En desarrollo: http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (envío de correos del formulario de contacto)
RESEND_API_KEY=
# Remitente verificado en Resend. En proyecto académico: onboarding@resend.dev
CONTACT_FROM_EMAIL=StudySync <onboarding@resend.dev>
# Destinatario del formulario de contacto. También se muestra en la UI.
CONTACT_TO_EMAIL=soporte@studysync.co
