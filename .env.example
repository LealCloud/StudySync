# ==========================================
# Runtime
# ==========================================

# Modo del cliente de backend. Valores posibles:
#   - `local` (default): monolito con Prisma + PostgreSQL. Requiere DATABASE_URL.
#   - `mock`: implementación en memoria. No requiere base de datos.
BACKEND_MODE=local

# Cadena de conexión a PostgreSQL. Requerida si BACKEND_MODE=local.
# Ejemplo: postgresql://studysync:studysync@localhost:5432/studysync
DATABASE_URL=postgresql://studysync:studysync@localhost:5432/studysync

# Secreto utilizado por Auth.js / NextAuth para firmar el JWT de sesión.
# Cada desarrollador debe generar su propio valor.
# Generar con: openssl rand -base64 32
AUTH_SECRET=
